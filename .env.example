# ─────────────────────────────────────────────────────────────
#  ShayStream — תבנית משתני סביבה (root, עבור docker-compose)
#  העתק לקובץ .env ומלא ערכים אמיתיים:   cp .env.example .env
#  הקובץ הזה (.env.example) נכנס ל-Git. הקובץ .env — לעולם לא!
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=shaystream
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_DB=shaystream
POSTGRES_PORT=5434 # פורט על ה-host (5432/5433 תפוסים ע"י פרויקטים אחרים)

# ── JWT (עבור auth-service) ──
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# ── MinIO (אחסון אובייקטים לווידאו) ──
MINIO_ROOT_USER=shaystream
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=shaystream-media
