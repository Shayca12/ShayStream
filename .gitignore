# ─────────────────────────────────────────────────────────────
#  ShayStream — .gitignore
#  אומר ל-Git אילו קבצים/תיקיות להתעלם מהם (לא לעקוב, לא להעלות).
# ─────────────────────────────────────────────────────────────

# ── תלויות (dependencies) ──
# node_modules יכולה להגיע לגיגה-בייטים. לא מעלים אותה —
# כל אחד מריץ `npm install` ומקבל אותה מ-package.json.
node_modules/

# ── תוצרי בנייה (build output) ──
# נוצרים מחדש מהקוד בכל build, אז אין טעם לעקוב אחריהם.
dist/
build/
.next/
out/

# ── סביבה וסודות (NEVER commit secrets!) ──
# .env מכיל סיסמאות, מפתחות JWT, מפתחות MinIO — לעולם לא ב-Git.
# אנחנו כן מעלים .env.example (תבנית ריקה) כדי לתעד אילו משתנים צריך.
.env
.env.local
.env.*.local
*.pem
*.key

# ── לוגים ──
*.log
npm-debug.log*
yarn-debug.log*

# ── זבל של מערכת הפעלה / עורך ──
.DS_Store
Thumbs.db
.idea/
# .vscode/ מושאר במכוון — לפעמים רוצים לשתף הגדרות עורך לצוות.

# ── דאטה מקומית של קונטיינרים (volumes bind-mounted) ──
# אם נמפה נתוני Postgres/MinIO לתיקייה מקומית — לא מעלים אותם.
.data/
